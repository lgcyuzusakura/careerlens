  "item": [
    {
      "name": "01 - full chain via public entry",
      "item": [
        {
          "name": "Analyze synthetic material via frontend /api",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{webBaseUrl}}/api/v1/analyses",
            "description": "契约预览：服务实现后运行。只含合成材料，默认不调用外部模型。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resumeText\": \"项目经历\\n使用 Java 和 Spring Boot 实现合成课程管理 API，并编写 JUnit 单元测试。\",\n  \"jdText\": \"必须掌握 Java、Spring Boot；Docker 经验优先。\",\n  \"options\": {\n    \"useExternalModel\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () { pm.response.to.have.status(200); });",
                  "pm.test('Business envelope: code, msg, data', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(Object.keys(body).sort()).to.eql(['code', 'data', 'msg']);",
                  "  pm.expect(body.code).to.be.a('string');",
                  "  pm.expect(body.msg).to.be.a('string');",
                  "});",
                  "pm.test('Trace header is present', function () { pm.expect(pm.response.headers.get('X-Trace-Id')).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i); });"
                ]
              }
            }
          ]
        },
