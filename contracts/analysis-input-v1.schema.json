{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "resumeText": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20000
    },
    "jdText": {
      "type": "string",
      "minLength": 10,
      "maxLength": 12000
    },
    "options": {
      "default": {
        "useExternalModel": false
      },
      "type": "object",
      "properties": {
        "useExternalModel": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "resumeText",
    "jdText"
  ],
  "additionalProperties": false
}
